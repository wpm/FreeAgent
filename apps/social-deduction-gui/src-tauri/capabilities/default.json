{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The viewer's window: core APIs, the game's commands, file dialogs for configurations, and opening links in the system browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }, { "url": "mailto:*" }]
    }
  ]
}
